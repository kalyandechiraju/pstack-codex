# Copy this file to ~/.codex/pstack-models.toml or .codex/pstack-models.toml.
# The port keeps role IDs stable in its skills and lets each Codex installation
# choose concrete models and reasoning effort.

[roles.pstack.fast]
model = "gpt-5.6-terra"
reasoning_effort = "low"

[roles.pstack.review]
model = "gpt-5.6-sol"
reasoning_effort = "medium"

[roles.pstack.judgment]
model = "gpt-6-astra"
reasoning_effort = "high"

[roles.pstack.deep-judgment]
model = "gpt-6-astra"
reasoning_effort = "xhigh"
